{
    "name": "@raa-pilot/opportunity-actions-control",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "description": "Standalone Opportunity recommendations pilot with server-authorized Done and Dismiss actions; not included in product solutions.",
    "scripts": {
        "build": "pcf-scripts build --buildMode production",
        "clean": "pcf-scripts clean",
        "refreshTypes": "pcf-scripts refreshTypes",
        "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
        "test": "jest --config jest.config.js",
        "check": "prettier --check \"OpportunityActionsControl/*.ts\" \"OpportunityActionsControl/src/**/*.{ts,tsx}\" \"tests/*.cjs\" && eslint OpportunityActionsControl tests --ext .ts,.tsx --ignore-pattern generated/**",
        "fix": "prettier --write \"OpportunityActionsControl/*.ts\" \"OpportunityActionsControl/src/**/*.{ts,tsx}\" \"tests/*.cjs\""
    },
    "dependencies": {
        "@fluentui/react-components": "9.72.3",
        "@fluentui/react-icons-mdl2": "1.4.7",
        "react": "16.14.0"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/node": "18.19.103",
        "@types/powerapps-component-framework": "1.3.18",
        "@types/react": "16.14.64",
        "@types/react-dom": "16.9.25",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "eslint": "8.57.1",
        "eslint-plugin-jsdoc": "44.2.7",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-prettier": "4.2.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "4.6.2",
        "jest": "29.7.0",
        "pcf-scripts": "1.43.6",
        "prettier": "2.8.8",
        "react-dom": "16.14.0",
        "ts-jest": "29.3.4",
        "typescript": "4.9.5"
    }
}